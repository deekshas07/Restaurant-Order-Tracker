    {
      "name": "3. Negative QA & Boundary Validation Tests",
      "item": [
        {
          "name": "[Negative] POST Empty Customer & Invalid Quantity (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Error payload contains descriptive validation details', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.error).to.eql('Bad Request');",
                  "    pm.expect(json.details).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"\",\n  \"food_item\": \"Burger\",\n  \"quantity\": -2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "[Negative] PUT Invalid Status Transition Completed -> Preparing (400 Bad Request)",
          "event": [
