            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{createdOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{createdOrderId}}"]
            }
          }
        },
        {
          "name": "PUT Transition 1: Pending -> Preparing (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
